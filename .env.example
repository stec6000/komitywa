# Skopiuj do .env i uzupelnij wartosci
# ====================================

# Django Core
SECRET_KEY=change-me-to-a-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (domyslnie SQLite; na produkcji PostgreSQL)
# DATABASE_URL=postgres://USER:PASSWORD@pgsqlX.mydevil.net:5432/DB_NAME

# Przelewy24
P24_MERCHANT_ID=
P24_POS_ID=
P24_CRC_KEY=
P24_API_KEY=
P24_SANDBOX=True

# Email (domyslnie console backend; na produkcji Brevo SMTP)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Kuchenna Komitywa <noreply@kuchennakomitywa.pl>

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security (wlacz na produkcji PO skonfigurowaniu HTTPS)
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
# CSRF_TRUSTED_ORIGINS=https://kuchennakomitywa.pl,https://www.kuchennakomitywa.pl
