# Skopiuj do .env i uzupełnij wartości
# ====================================

# Django Core
SECRET_KEY=change-me-to-a-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,kuchennakomitywa.pl,www.kuchennakomitywa.pl

# Database (domyślnie SQLite; na produkcji PostgreSQL)
# DATABASE_URL=postgres://USER:PASSWORD@pgsqlX.mydevil.net:5432/DB_NAME

# Przelewy24
P24_MERCHANT_ID=
P24_POS_ID=
P24_CRC_KEY=
P24_API_KEY=
P24_SANDBOX=True

# Email (domyślnie console backend; na produkcji Brevo SMTP)
# Na produkcji ustaw:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=<login z Brevo SMTP>
# EMAIL_HOST_PASSWORD=<klucz SMTP z Brevo>
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Kuchenna Komitywa <noreply@kuchennakomitywa.pl>

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security (włącz na produkcji po skonfigurowaniu HTTPS)
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
CSRF_TRUSTED_ORIGINS=https://kuchennakomitywa.pl,https://www.kuchennakomitywa.pl

# Cloudflare Turnstile (anti-bot dla newsletter signup) — opcjonalne, brak = graceful skip
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
